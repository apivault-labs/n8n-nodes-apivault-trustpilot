      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json; const rating = Number(j.rating ?? j.stars ?? 0); return { json: { ...j, reputationAction: { company: j.companyName ?? j.company ?? j.domain ?? '', rating, reviewText: j.text ?? j.reviewText ?? '', replyPresent: Boolean(j.reply ?? j.ownerReply), priority: rating > 0 && rating <= 2 ? 'high' : rating === 3 ? 'medium' : 'normal', reviewUrl: j.reviewUrl ?? j.url ?? '' } } };"
      },
